ARG FEDORA_MAJOR_VERSION=44
ARG FEDORA_DE=silverblue

FROM quay.io/fedora-ostree-desktops/${FEDORA_DE}:${FEDORA_MAJOR_VERSION}

RUN curl -fsSL -o /etc/yum.repos.d/tailscale.repo https://pkgs.tailscale.com/stable/centos/9/tailscale.repo

RUN dnf install -y \
        https://mirrors.rpmfusion.org/free/fedora/rpmfusion-free-release-44.noarch.rpm \
        https://mirrors.rpmfusion.org/nonfree/fedora/rpmfusion-nonfree-release-44.noarch.rpm && \
    dnf clean all

RUN cat > /etc/yum.repos.d/asus-linux.repo <<'EOF'
[asus-linux]
name=Copr repo for asus-linux owned by lukenukem
baseurl=https://download.copr.fedorainfracloud.org/results/lukenukem/asus-linux/fedora-$releasever-$basearch/
type=rpm-md
skip_if_unavailable=True
gpgcheck=1
gpgkey=https://download.copr.fedorainfracloud.org/results/lukenukem/asus-linux/pubkey.gpg
repo_gpgcheck=0
enabled=1
enabled_metadata=1
EOF

COPY nordvpn.asc /etc/pki/rpm-gpg/RPM-GPG-KEY-nordvpn

RUN cat > /etc/yum.repos.d/nordvpn.repo <<'EOF'
[nordvpn]
name=nordvpn - Created by dnf5 config-manager
enabled=1
baseurl=https://repo.nordvpn.com/yum/nordvpn/centos/x86_64
gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-nordvpn
EOF

# NordVPN's optional GUI package does not currently install cleanly in the
# Silverblue filesystem layout, so install the CLI/daemon without weak deps.
RUN dnf install -y --setopt=install_weak_deps=False nordvpn && \
    dnf clean all

